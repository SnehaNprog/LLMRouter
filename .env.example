LLMROUTER_APP_NAME=LLMRouter
LLMROUTER_ENVIRONMENT=dev
LLMROUTER_LOG_LEVEL=INFO
LLMROUTER_CONFIG_PATH=config.yaml
LLMROUTER_REDIS_URL=redis://localhost:6379/0
# If Redis (which holds all quotas) is down: "open" lets requests through unenforced,
# "closed" refuses requests from keys that have limits.
LLMROUTER_QUOTA_FAILURE_MODE=open

# Provider keys referenced from config.yaml as os.environ/NAME (export them in your shell)
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# ---- running with docker compose (`make up`) ----
# Used for the Postgres container and the gateway's connection to it. Letters and digits only,
# since it is placed in a URL. The default is for laptops; change it anywhere real.
# POSTGRES_PASSWORD=
# Host ports (the containers always listen on the standard ones).
# APP_PORT=8000
# REDIS_PORT=6379
